[Unit]
Description=SrikanthMart Native C++20 Marketplace Service
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/srikanthmart
ExecStart=/opt/srikanthmart/bin/srikanthmart
Restart=always
RestartSec=5
Environment=PORT=8080
Environment=AI_CHATBOT_PROVIDER=mock
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
